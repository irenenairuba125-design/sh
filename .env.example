SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Pesapal (create a merchant account at https://developer.pesapal.com)
# Use the sandbox keys first, switch PESAPAL_ENV to "live" and use live keys when you go live.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=

# Public base URL of this site (used to build the Pesapal callback/IPN URLs).
# During local development, point this at your ngrok/tunnel URL, not 127.0.0.1 -
# Pesapal cannot reach your laptop directly.
SITE_URL=http://127.0.0.1:8000
